{
  "name": "wiki-cli (Go)",
  "image": "mcr.microsoft.com/devcontainers/go:1-1-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true
      }
    }
  },
  "postCreateCommand": "go version",
  "remoteUser": "vscode"
}